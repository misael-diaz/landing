CC = gcc

CWD = $(shell pwd)
CCOPT = -DDEVBUILD=1 \
	-DDIRBUILD=\"$(CWD)\" \
	-g \
	-Wall \
	-Wextra \
	-Wformat \
	-gdwarf-4 \
	-O0

# we need --export-dynamic to call hydrogen utils from the modules
LNOPT = -Wl,--export-dynamic
LIBS = -ldl

SRV_CXX = main.cpp
SRV_OBJ = main.obj
SRV_BIN = hydrogen.bin

# normally you would compile these in a separate project but it does not hurt to recompile the whole thing
FAVICON_CXX = favicon.cpp
MATHWORKS_CXX = mathworks.cpp
WHATSAPP_CXX = whatsapp.cpp
GAMEPAD_CXX = gamepad.cpp
NEXTJS_CXX = nextjs.cpp
HERO_CXX = hero.cpp
UPRM_CXX = uprm.cpp
PUPR_CXX = pupr.cpp
XORG_CXX = xorg.cpp
ICMM_CXX = icmm.cpp
PSU_CXX = psu.cpp
UND_CXX = und.cpp
UN_CXX = un.cpp
ROOT_CXX = root.cpp

FAVICON_SO = modules/favicon.so
MATHWORKS_SO = modules/mathworks.so
WHATSAPP_SO = modules/whatsapp.so
GAMEPAD_SO = modules/gamepad.so
NEXTJS_SO = modules/nextjs.so
HERO_SO = modules/hero.so
UPRM_SO = modules/uprm.so
PUPR_SO = modules/pupr.so
XORG_SO = modules/xorg.so
ICMM_SO = modules/icmm.so
PSU_SO = modules/psu.so
UND_SO = modules/und.so
UN_SO = modules/un.so
ROOT_SO = modules/root.so

MODULES = $(FAVICON_SO) \
	  $(NEXTJS_SO) \
	  $(MATHWORKS_SO) \
	  $(WHATSAPP_SO) \
	  $(GAMEPAD_SO) \
	  $(HERO_SO) \
	  $(UPRM_SO) \
	  $(PUPR_SO) \
	  $(XORG_SO) \
	  $(ICMM_SO) \
	  $(PSU_SO) \
	  $(UND_SO) \
	  $(UN_SO) \
	  $(ROOT_SO)
