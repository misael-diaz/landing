CC = gcc

CWD = $(shell pwd)
CCOPT = -DDEVBUILD=1 \
	-DDIRBUILD=\"$(CWD)\" \
	-g \
	-Wall \
	-Wextra \
	-Wformat \
	-gdwarf-4 \
	-O0

# we need --export-dynamic to call hydrogen utils from the modules
LNOPT = -Wl,--export-dynamic
LIBS = -ldl

SRV_CXX = main.cpp
SRV_OBJ = main.obj
SRV_BIN = hydrogen.bin

# normally you would compile these in a separate project but it does not hurt to recompile the whole thing
FAVICON_CXX = favicon.cpp
SCIENTIFIC_CXX = scientific.cpp
MATHWORKS_CXX = mathworks.cpp
TERMINAL_CXX = terminal.cpp
WHATSAPP_CXX = whatsapp.cpp
LINKEDIN_CXX = linkedin.cpp
YOUTUBE_CXX = youtube.cpp
GAMEPAD_CXX = gamepad.cpp
GITHUB_CXX = github.cpp
THESIS_CXX = thesis.cpp
NEXTJS_CXX = nextjs.cpp
GMAIL_CXX = gmail.cpp
HERO_CXX = hero.cpp
UPRM_CXX = uprm.cpp
STEM_CXX = stem.cpp
PUPR_CXX = pupr.cpp
XORG_CXX = xorg.cpp
ICMM_CXX = icmm.cpp
PSU_CXX = psu.cpp
DEV_CXX = dev.cpp
UND_CXX = und.cpp
UN_CXX = un.cpp
ROOT_CXX = root.cpp

FAVICON_SO = modules/favicon.so
SCIENTIFIC_SO = modules/scientific.so
MATHWORKS_SO = modules/mathworks.so
TERMINAL_SO = modules/terminal.so
WHATSAPP_SO = modules/whatsapp.so
LINKEDIN_SO = modules/linkedin.so
YOUTUBE_SO = modules/youtube.so
GAMEPAD_SO = modules/gamepad.so
GITHUB_SO = modules/github.so
THESIS_SO = modules/thesis.so
NEXTJS_SO = modules/nextjs.so
GMAIL_SO = modules/gmail.so
HERO_SO = modules/hero.so
UPRM_SO = modules/uprm.so
STEM_SO = modules/stem.so
PUPR_SO = modules/pupr.so
XORG_SO = modules/xorg.so
ICMM_SO = modules/icmm.so
PSU_SO = modules/psu.so
DEV_SO = modules/dev.so
UND_SO = modules/und.so
UN_SO = modules/un.so
ROOT_SO = modules/root.so

MODULES = $(FAVICON_SO) \
	  $(NEXTJS_SO) \
	  $(SCIENTIFIC_SO) \
	  $(MATHWORKS_SO) \
	  $(TERMINAL_SO) \
	  $(WHATSAPP_SO) \
	  $(LINKEDIN_SO) \
	  $(YOUTUBE_SO) \
	  $(GAMEPAD_SO) \
	  $(GITHUB_SO) \
	  $(THESIS_SO) \
	  $(GMAIL_SO) \
	  $(HERO_SO) \
	  $(UPRM_SO) \
	  $(STEM_SO) \
	  $(PUPR_SO) \
	  $(XORG_SO) \
	  $(ICMM_SO) \
	  $(PSU_SO) \
	  $(DEV_SO) \
	  $(UND_SO) \
	  $(UN_SO) \
	  $(ROOT_SO)
